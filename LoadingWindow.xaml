<Window x:Class="Z8Routegraph2n.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Z8Routegraph2n"
        mc:Ignorable="d"
        Title="Strecke/Fahrplan laden..." Height="210" Width="442">
    <StackPanel>
        <Label x:Name="lblSuchen" Content="Suche Strecken..." Margin="10,0,10,0"/>
        <Label x:Name="lblLaden" Content="Lade Strecken..." Margin="10,0,10,0"/>
        <Label x:Name="lblLink" Content="Verknüpfungen herstellen..." Margin="10,0,10,0"/>
        <Label x:Name="lblView" Content="Ansicht vorbereiten..." Margin="10,0,10,0"/>
        <ProgressBar Height="21" IsIndeterminate="True" Margin="10,10,10,10"/>
        <Button x:Name="btnCancel" Content="Abbrechen" Width="158" Height="23" Click="btnCancel_Click" Margin="0,0,0,10" />

    </StackPanel>
</Window>
